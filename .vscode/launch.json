{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Cypress Tests",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/cypress/bin/cypress",
      "args": ["run", "--spec", "${relativeFile}"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    }
  ]
}